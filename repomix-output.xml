<file path="src/App.css">
@import "tailwindcss";
@import "./styles/theme.css";

/* Register the shared color tokens (src/styles/theme.css) as Tailwind
   utilities */
@theme inline {
  --color-text: var(--color-text);
  --color-background: var(--color-background);
  --color-background-ui: var(--color-background-ui);
  --color-logo-primary: var(--color-logo-primary);
  --color-logo-stroke: var(--color-logo-stroke);
  --color-text-stroke: var(--color-text-stroke);
  --color-mid-gray: var(--color-mid-gray);
  --color-warning: var(--color-warning);
  --color-error: var(--color-error);
}

:root {
  /* Typography */
  font-size: 15px;
  line-height: 24px;
  font-weight: 400;

  /* Typography settings */
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  -webkit-text-size-adjust: 100%;

  --scrollbar-thumb: color-mix(in srgb, var(--color-text), transparent 85%);
  --scrollbar-thumb-hover: color-mix(
    in srgb,
    var(--color-text),
    transparent 70%
  );

  /* Log console surface — a subtle shade off the app background so the live log
     viewer reads as a distinct console. In light mode this is a faint gray code
     block (matching other surfaces); the dark theme overrides it below. */
  --color-log-surface: color-mix(in srgb, var(--color-background), black 6%);

  /* Apply colors */
  color: var(--color-text);
  background-color: var(--color-background);
}

.container {
  margin: 0;
  padding-top: 10vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

@media (prefers-color-scheme: dark) {
  :root {
    /* Just a bit darker than the (already dark) background, keeping its warm tint */
    --color-log-surface: color-mix(in srgb, var(--color-background), black 15%);
  }
}

/* Keep onboarding centered when classic scrollbars consume layout space.
   Overlay scrollbars do not reserve a gutter, so this has no effect on them. */
:root[data-onboarding-active] {
  scrollbar-gutter: stable both-edges;
}

/* macOS - tint native overlay scrollbar thumb */
:root[data-platform="macos"] {
  scrollbar-color: var(--scrollbar-thumb) transparent;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 14px;
  height: 14px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background-color: var(--scrollbar-thumb);
  border-radius: 20px;
  border: 3px solid transparent;
  border-right-width: 4px;
